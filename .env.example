# =============================================================
# Configuracao do Sistema de Gestao de Produtos Quimicos
# Copie este arquivo para ".env" e ajuste os valores.
# =============================================================

# --- Banco de dados -------------------------------------------------
# sqlite = desenvolvimento local (nao precisa instalar nada)
# mssql  = SQL Server (producao)
DB_ENGINE=sqlite

# Usado quando DB_ENGINE=sqlite
SQLITE_PATH=gestao_quimicos.db

# Usados quando DB_ENGINE=mssql
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=GestaoQuimicos
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
# Para autenticacao integrada do Windows (dominio), use: MSSQL_TRUSTED=1
MSSQL_TRUSTED=0

# --- Sessao / seguranca ---------------------------------------------
SECRET_KEY=troque-esta-chave-em-producao

# --- Envio de e-mail (SMTP) -----------------------------------------
# Se SMTP_HOST ficar vazio, os e-mails NAO sao enviados: ficam
# registrados na tabela de notificacoes (Caixa de saida) para conferencia.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=1
SMTP_FROM=gestao.quimicos@tenaris.com

# --- Upload de arquivos ---------------------------------------------
# Tamanho maximo por arquivo, em MB
MAX_UPLOAD_MB=20
